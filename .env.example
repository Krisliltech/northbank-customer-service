DATABASE_URL= your database url
DATABASE_USERNAME= your database username
DATABASE_PASSWORD= your database password
JWT_SECRET = your jwt secret
JWT_EXPIRATION = your jwt expiration
SWAGGER_ENABLED= true or false based on the environment
API_ENABLED= true or false based on the environment


# --- Initial admin bootstrap ---
# The first admin will only be created on startup if there is no active admin in the system, or if the email does not exist
ADMIN_EMAIL= admin email for seeding the first admin into the system


# ---- Must meet the rules for password generation: ------
#   - 8 to 64 characters
#   - at least one lowercase letter, one uppercase letter and one digit
#   - at least one special character (anything that is not a letter, digit or space)
#   - must not start or end with whitespace
# Do not use $ # quotes or backslashes (Docker Compose and .env parsing), and do not wrap it in quotes.
# Remove this line from .env after the first admin is created.
ADMIN_PASSWORD= admin password
# ------------------------------